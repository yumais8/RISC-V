{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build with Verilator",
            "type": "shell",
            "command": "verilator",
            "args": [
                "--cc",
                "tb/tb.sv",
                "src/datapath.sv",
                "src/pc.sv",
                "src/orchestrationMemory.sv",
                "src/mux2.sv",
                "src/IFID.sv",
                "tb/tb.cpp",
                "src/pcAdder.sv",
                "src/sext.sv",
                "src/regFile.sv",
                "src/IDEX.sv",
                "src/control.sv",
                "src/alu.sv",
                "src/mux4.sv",
                "src/EXMEM.sv",
                "src/branchComp.sv",
                "src/memory.sv",
                "src/MEMWB.sv",
                "src/forwarding.sv",
                "--exe",
                "--build",
                "--trace",
                "--timing",
                "--top-module",
                "tb",
                "&&",
                "./obj_dir/Vtb"
            ],
            "problemMatcher": {
                "owner": "verilator",
                "fileLocation": ["relative", "${workspaceFolder}"],
                "pattern": {
                    "regexp": "^%(Error|Warning)[^:]*: ([^:]+):(\\d+):(\\d+): (.*)$",
                    "severity": 1,
                    "file": 2,
                    "line": 3,
                    "column": 4,
                    "message": 5
                }
            }
        }
    ]
}