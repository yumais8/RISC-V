        <mxCell id="afNwNpoGMVzTnEFJhnk_-20" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Examples&lt;/h1&gt;&lt;p&gt;Lui x1, 20&#39;b00000000000000000001 --&amp;gt; rs1 = 1&lt;/p&gt;&lt;p&gt;Lui x2, 20&#39;b00000000000000000010 --&amp;gt; rs2 = 2&lt;/p&gt;&lt;p&gt;add, x1, x1, x2 --&amp;gt; rs1 = 3&lt;/p&gt;&lt;p&gt;auipc x8, 20&#39;h0 --&amp;gt; saving PC value&lt;/p&gt;&lt;p&gt;xor x1, x2, x1 --&amp;gt; xor two registers values and store into register&lt;/p&gt;&lt;p&gt;xori x1, x2, 7&#39;h7&lt;/p&gt;&lt;p&gt;lw&amp;nbsp; x2, offset(x1) --&amp;gt; load immediate and add it to x1 then find that memory, save data into x2.&amp;nbsp;&lt;/p&gt;&lt;p&gt;jalr x3, offset(x2) --&amp;gt; store next pc into x3, and jump to (x2+immediate) &amp;amp; ~1 (making sure the address ends in the zero ending address space)&lt;/p&gt;&lt;p&gt;slli x4, x1, 5&#39;h1 --&amp;gt; logical left shift value in x1 by the amount in the lower 5 bits of immediate, and store in x4&lt;/p&gt;&lt;p&gt;sw x5, offset(x1) --&amp;gt; store value (x1 + offset) into destination register x5&lt;/p&gt;&lt;p&gt;beq x1, x2, offset --&amp;gt; if x1 == x2, pc += sext(offset))&lt;/p&gt;&lt;p&gt;jal x8, offset --&amp;gt; rd = pc + 4, pc += sext(offset)&amp;nbsp;&lt;/p&gt;" vertex="1">
          <mxGeometry height="400" width="390" x="930" y="-740" as="geometry" />
        </mxCell>
